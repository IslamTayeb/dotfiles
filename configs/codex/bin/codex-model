#!/usr/bin/env node

import { execFileSync, spawnSync } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import readline from "node:readline/promises";

const codexHomePath = process.env.CODEX_HOME || path.join(os.homedir(), ".codex");
const configPath = path.join(codexHomePath, "config.toml");
const statePath = path.join(codexHomePath, "model-switcher.json");

const choices = {
  openai: {
    label: "OpenAI — GPT-5.6 Sol",
    model: "gpt-5.6-sol",
    effort: "medium",
    provider: null,
  },
  opus: {
    label: "Claude Opus 5",
    model: "claude-opus-5",
    effort: "high",
    provider: "meridian",
  },
  fable: {
    label: "Claude Fable 5",
    model: "claude-fable-5",
    effort: "high",
    provider: "meridian",
  },
  sonnet: {
    label: "Claude Sonnet 5",
    model: "claude-sonnet-5",
    effort: "high",
    provider: "meridian",
  },
  haiku: {
    label: "Claude Haiku 4.5",
    model: "claude-haiku-4-5",
    effort: "medium",
    provider: "meridian",
  },
};

const aliases = new Map([
  ["gpt", "openai"],
  ["gpt-5.6-sol", "openai"],
  ["claude-opus-5", "opus"],
  ["claude-fable-5", "fable"],
  ["claude-sonnet-5", "sonnet"],
  ["claude-haiku-4-5", "haiku"],
]);

function fail(message) {
  console.error(`codex-model: ${message}`);
  process.exit(1);
}

function readConfig() {
  try {
    return fs.readFileSync(configPath, "utf8");
  } catch (error) {
    fail(`cannot read ${configPath}: ${error.message}`);
  }
}

function topLevelConfig(raw) {
  const lines = raw.split(/\r?\n/);
  const firstTable = lines.findIndex((line) => /^\s*\[/.test(line));
  const splitAt = firstTable === -1 ? lines.length : firstTable;
  return {
    preamble: lines.slice(0, splitAt),
    body: lines.slice(splitAt),
  };
}

function readTopLevelValue(raw, key) {
  const { preamble } = topLevelConfig(raw);
  const pattern = new RegExp(`^\\s*${key}\\s*=\\s*"(.*)"\\s*$`);
  for (const line of preamble) {
    const match = line.match(pattern);
    if (match) return match[1];
  }
  return null;
}

function currentChoice(raw) {
  const model = readTopLevelValue(raw, "model");
  const provider = readTopLevelValue(raw, "model_provider");
  for (const [name, choice] of Object.entries(choices)) {
    if (choice.model === model && choice.provider === provider) return name;
  }
  return null;
}

function loadState() {
  try {
    return JSON.parse(fs.readFileSync(statePath, "utf8"));
  } catch {
    return { lastClaude: "opus" };
  }
}

function atomicWrite(filePath, contents, mode = 0o600) {
  const temporaryPath = `${filePath}.tmp.${process.pid}`;
  const descriptor = fs.openSync(
    temporaryPath,
    fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL,
    mode,
  );
  try {
    fs.writeFileSync(descriptor, contents);
    fs.fsyncSync(descriptor);
  } finally {
    fs.closeSync(descriptor);
  }
  fs.renameSync(temporaryPath, filePath);
  fs.chmodSync(filePath, mode);
}

function renderConfig(raw, choice) {
  const { preamble, body } = topLevelConfig(raw);
  const managedKeys = new Set([
    "model",
    "model_provider",
    "model_reasoning_effort",
  ]);
  const unmanagedPreamble = preamble.filter((line) => {
    const match = line.match(/^\s*([A-Za-z0-9_-]+)\s*=/);
    return !match || !managedKeys.has(match[1]);
  });

  while (unmanagedPreamble.length && unmanagedPreamble[0].trim() === "") {
    unmanagedPreamble.shift();
  }
  while (
    unmanagedPreamble.length &&
    unmanagedPreamble[unmanagedPreamble.length - 1].trim() === ""
  ) {
    unmanagedPreamble.pop();
  }

  const managed = [
    `model = "${choice.model}"`,
    `model_reasoning_effort = "${choice.effort}"`,
  ];
  if (choice.provider) managed.push(`model_provider = "${choice.provider}"`);

  const lines = [...managed];
  if (unmanagedPreamble.length) lines.push("", ...unmanagedPreamble);
  if (body.length) lines.push("", ...body);
  return `${lines.join("\n").replace(/\n+$/, "")}\n`;
}

function findCodex() {
  const appCodex = "/Applications/ChatGPT.app/Contents/Resources/codex";
  if (fs.existsSync(appCodex)) return appCodex;
  try {
    return execFileSync("/usr/bin/which", ["codex"], {
      encoding: "utf8",
    }).trim();
  } catch {
    fail("cannot find a Codex executable for configuration validation");
  }
}

function validateConfig() {
  const result = spawnSync(findCodex(), ["--version"], {
    encoding: "utf8",
    env: process.env,
  });
  if (result.status !== 0) {
    const detail = (result.stderr || result.stdout || "unknown error").trim();
    throw new Error(detail);
  }
}

function verifyMeridian() {
  const result = spawnSync(
    "/usr/bin/curl",
    [
      "-fsS",
      "--retry",
      "2",
      "--retry-connrefused",
      "--retry-delay",
      "1",
      "--max-time",
      "5",
      "http://127.0.0.1:3456/health",
    ],
    { encoding: "utf8" },
  );
  if (result.status !== 0) {
    fail(
      "Meridian is not healthy at 127.0.0.1:3456; the configuration was not changed",
    );
  }
  try {
    const health = JSON.parse(result.stdout);
    if (
      health.status !== "healthy" ||
      health.auth?.loggedIn !== true ||
      health.auth?.subscriptionType !== "max"
    ) {
      fail(
        "Meridian is reachable but does not report a healthy authenticated Max session",
      );
    }
  } catch {
    fail("Meridian returned an invalid health response; the configuration was not changed");
  }
}

function timestamp() {
  const now = new Date();
  const value = [
    now.getFullYear(),
    String(now.getMonth() + 1).padStart(2, "0"),
    String(now.getDate()).padStart(2, "0"),
    String(now.getHours()).padStart(2, "0"),
    String(now.getMinutes()).padStart(2, "0"),
    String(now.getSeconds()).padStart(2, "0"),
    String(now.getMilliseconds()).padStart(3, "0"),
  ].join("");
  return value;
}

function switchTo(name) {
  const choice = choices[name];
  if (!choice) fail(`unknown model choice: ${name}`);
  if (choice.provider === "meridian") verifyMeridian();

  const original = readConfig();
  const backupPath = `${configPath}.backup.model-switch.${timestamp()}`;
  fs.copyFileSync(configPath, backupPath, fs.constants.COPYFILE_EXCL);
  fs.chmodSync(backupPath, 0o600);

  try {
    atomicWrite(configPath, renderConfig(original, choice));
    validateConfig();
  } catch (error) {
    fs.copyFileSync(backupPath, configPath);
    fs.chmodSync(configPath, 0o600);
    fail(`validation failed; restored ${backupPath}: ${error.message}`);
  }

  const state = loadState();
  if (choice.provider === "meridian") state.lastClaude = name;
  atomicWrite(statePath, `${JSON.stringify(state, null, 2)}\n`);

  console.log(`Codex default: ${choice.label}`);
  console.log(`Backup: ${backupPath}`);
  console.log("No app restart is needed. Start a new Codex task to use this model.");
}

function printStatus() {
  const raw = readConfig();
  const name = currentChoice(raw);
  const model = readTopLevelValue(raw, "model") || "(default)";
  const provider = readTopLevelValue(raw, "model_provider") || "openai";
  console.log(`Model: ${model}`);
  console.log(`Provider: ${provider}`);
  if (name) console.log(`Choice: ${choices[name].label}`);
}

async function chooseInteractively() {
  if (!process.stdin.isTTY || !process.stdout.isTTY) {
    fail("interactive selection requires a terminal; pass openai, opus, fable, sonnet, or haiku");
  }

  const ordered = ["openai", "opus", "fable", "sonnet", "haiku"];
  console.log("Choose the model for new Codex tasks:");
  ordered.forEach((name, index) => {
    console.log(`  ${index + 1}. ${choices[name].label}`);
  });

  const terminal = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
  });
  const answer = (await terminal.question("Selection: ")).trim();
  terminal.close();

  const index = Number.parseInt(answer, 10) - 1;
  if (!Number.isInteger(index) || !ordered[index]) fail("invalid selection");
  return ordered[index];
}

function printUsage() {
  console.log(`Usage: codex-model [choice]

Choices:
  openai | gpt       GPT-5.6 Sol through OpenAI
  opus               Claude Opus 5
  fable              Claude Fable 5
  sonnet             Claude Sonnet 5
  haiku              Claude Haiku 4.5
  claude             Last selected Claude model
  toggle             Toggle between OpenAI and the last Claude model
  status             Show the configured default

With no argument, codex-model opens an interactive menu.
Changes apply to new Codex tasks; running tasks keep their current model.`);
}

let requested = process.argv[2]?.toLowerCase();
if (!requested) requested = await chooseInteractively();
if (requested === "-h" || requested === "--help" || requested === "help") {
  printUsage();
  process.exit(0);
}
if (requested === "status") {
  printStatus();
  process.exit(0);
}

const raw = readConfig();
const state = loadState();
if (requested === "claude") requested = state.lastClaude || "opus";
if (requested === "toggle") {
  requested =
    readTopLevelValue(raw, "model_provider") === "meridian"
      ? "openai"
      : state.lastClaude || "opus";
}
requested = aliases.get(requested) || requested;
switchTo(requested);
