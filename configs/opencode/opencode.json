{
  "$schema": "https://opencode.ai/config.json",
  "model": "amazon-bedrock/us.anthropic.claude-opus-4-7:max",
  "permission": "allow",
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "us-east-1",
        "profile": "default"
      },
      "models": {
        "us.anthropic.claude-opus-4-7": {
          "variants": {
            "max": {
              "reasoningConfig": {
                "type": "adaptive",
                "maxReasoningEffort": "max"
              }
            },
            "high": {
              "reasoningConfig": {
                "type": "adaptive",
                "maxReasoningEffort": "high"
              }
            },
            "xhigh": {
              "reasoningConfig": {
                "type": "adaptive",
                "maxReasoningEffort": "xhigh"
              }
            }
          }
        }
      }
    },
    "openai": {
      "models": {
        "gpt-5.4": {
          "options": {
            "reasoningEffort": "xhigh"
          }
        }
      }
    }
  },
  "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "extensions": [
        ".js",
        ".ts",
        ".jsx",
        ".tsx",
        ".css",
        ".html",
        ".json",
        ".yaml",
        ".yml"
      ]
    },
    "ruff": {
      "command": ["uv", "run", "ruff", "format", "$FILE"],
      "extensions": [".py"]
    }
  }
}
