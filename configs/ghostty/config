# Ghostty config. Managed by home-manager (dotfiles/configs/ghostty/config).
# Docs: ghostty +show-config --default --docs

theme = Kanagawa Dragon

font-size = 22
font-thicken = true
font-thicken-strength = 1
adjust-cell-height = 1

confirm-close-surface = false
bell-features = false
keybind = "global:cmd+ctrl+left=unbind"
keybind = "global:cmd+ctrl+right=unbind"
