# Ghostty shared config. Home Manager links this to ~/.config/ghostty/config.ghostty.
# Per-machine look (theme, font size, padding, cursor) lives in
# configs/ghostty/hosts/<username>.ghostty, linked to ~/.config/ghostty/host.ghostty
# and included at the bottom of this file.
#
# On macOS, ~/Library/Application Support/com.mitchellh.ghostty/config* is searched
# first and would shadow this file, so keep that directory free of config files.

# No font-family: Ghostty's bundled JetBrains Mono plus its "Symbols Nerd Font"
# fallback already cover powerlevel10k's nerdfont-v3 icons.
font-family =
font-thicken = true

mouse-hide-while-typing = true
macos-option-as-alt = true
confirm-close-surface = false
bell-features = false

# ssh-env/ssh-terminfo stay off: the zshrc ssh wrapper handles both.
# clipboard-write stays at the default (allow) so OSC 52 copy from remote tmux works.
shell-integration = detect
shell-integration-features = cursor,title,no-sudo,no-ssh-env,no-ssh-terminfo

# ctrl+l stays unbound: it is the local tmux prefix.
keybind = global:cmd+ctrl+left=unbind
keybind = global:cmd+ctrl+right=unbind

# Per-machine overrides. A missing file is ignored.
config-file = ?host.ghostty
