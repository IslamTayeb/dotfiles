# Auto-attach human SSH sessions to tmux without breaking Codex remote commands.
if [[ -o interactive && "$OSTYPE" == linux* && -t 0 && -t 1 && -n "$SSH_TTY" && -z "$TMUX" && "${CODEX_AUTO_TMUX:-1}" != "0" && "$TERM" != "dumb" ]] && { : </dev/tty >/dev/tty; } 2>/dev/null; then
  _codex_tmux_command_shell=0
  if [[ -r "/proc/$$/cmdline" ]]; then
    _codex_tmux_cmdline="$(tr '\0' ' ' <"/proc/$$/cmdline")"
    if [[ "$_codex_tmux_cmdline" == *" -c "* || "$_codex_tmux_cmdline" == *" -ic "* || "$_codex_tmux_cmdline" == *" -lc "* || "$_codex_tmux_cmdline" == *" -lic "* ]]; then
      _codex_tmux_command_shell=1
    fi
  fi

  if [[ "$_codex_tmux_command_shell" != "1" ]] && command -v tmux >/dev/null 2>&1; then
    _codex_tmux_original_term="$TERM"
    if [[ "$TERM" == "xterm-ghostty" || "$TERM" == "ghostty" ]] && ! infocmp "$TERM" >/dev/null 2>&1; then
      export TERM="xterm-256color"
    fi

    command tmux new-session -A -s "${CODEX_TMUX_SESSION:-main}" || true
    export TERM="$_codex_tmux_original_term"
  fi

  unset _codex_tmux_command_shell _codex_tmux_cmdline _codex_tmux_original_term
fi

