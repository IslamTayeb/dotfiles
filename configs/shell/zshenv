# Minimal environment for every zsh invocation, including non-interactive SSH.
typeset -U path PATH

path_prepend_if_dir() {
  [[ -d "$1" ]] || return 0
  path=("$1" "${path[@]}")
}

path_prepend_if_dir "$HOME/bin"
path_prepend_if_dir "$HOME/.local/bin"
path_prepend_if_dir "$HOME/.nix-profile/bin"
path_prepend_if_dir "/nix/var/nix/profiles/default/bin"
path_prepend_if_dir "$HOME/.opencode/bin"
path_prepend_if_dir "$HOME/.cargo/bin"
path_prepend_if_dir "$HOME/.local/share/mise/shims"

export PATH

unfunction path_prepend_if_dir
